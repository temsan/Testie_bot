# Интерактивный вариант деплоя avito_bot.py: постоянный Chrome с виртуальным
# рабочим столом (Xvfb + x11vnc + noVNC) в том же контейнере. Логин на
# avito.ru делается один раз через noVNC — см. AVITO_BOT_PLAYBOOK.md,
# раздел «Деплой на Fly.io с интерактивным логином».
#
# Для headless-варианта (готовые cookies, без графики) используйте обычный
# Dockerfile — этот, Dockerfile.desktop, тяжелее и предназначен именно для
# первого логина / случаев, когда переэкспортировать cookies неудобно.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        supervisor \
        python3 \
        python3-venv \
        curl \
        ca-certificates \
        fonts-liberation \
        dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /data/chrome-profile

COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/start-chrome.sh /usr/local/bin/start-chrome.sh
COPY docker/wait-for-cdp.sh /usr/local/bin/wait-for-cdp.sh
RUN chmod +x /usr/local/bin/start-chrome.sh /usr/local/bin/wait-for-cdp.sh

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf", "-n"]
