BOT_TOKEN=your_telegram_bot_token_here

# Telegram user_id администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789

# --- avito_bot.py ---

# Ключ OpenRouter (https://openrouter.ai/keys) — используется только для
# классификации свободных ответов лида в один из вариантов budget/timeline.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Бесплатная модель OpenRouter (id из https://openrouter.ai/models?max_price=0)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Режим A: локальный запуск через уже открытый Chrome ---
# Адрес Chrome DevTools Protocol — Chrome должен быть запущен с флагом
# --remote-debugging-port=9222 и залогинен на avito.ru как продавец.
# Используется, если AVITO_STORAGE_STATE_B64 / AVITO_STORAGE_STATE_PATH не заданы.
CDP_URL=http://localhost:9222

# --- Режим B: запуск на хостинге (Railway и т.п.), без открытого Chrome ---
# Сохранённая сессия Avito в base64 — получить через export_avito_session.py
# локально и вставить сюда (полностью заменяет CDP_URL, если задано).
# AVITO_STORAGE_STATE_B64=...
#
# Либо путь к файлу сессии на диске хостинга (альтернатива base64-переменной)
# AVITO_STORAGE_STATE_PATH=avito_storage_state.json

# Каталог для avito_state.json — указывайте на смонтированный volume на
# хостинге, чтобы состояние диалогов не терялось при рестарте контейнера
# AVITO_STATE_DIR=/data

# Интервал опроса Avito Messenger, секунды
POLL_INTERVAL_SECONDS=30
