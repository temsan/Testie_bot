BOT_TOKEN=your_telegram_bot_token_here

# Telegram user_id администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789

# Основной провайдер диалога — Gemini (aistudio.google.com/apikey). У free
# tier всего 20 запросов/сутки на модель — при нехватке лимита бот сам
# переключается на OPENROUTER_API_KEY ниже, ключ Gemini можно не указывать.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# Бесплатный ключ OpenRouter (openrouter.ai/keys) — фолбек, если Gemini
# недоступен/исчерпал дневной лимит; либо основной провайдер, если
# GEMINI_API_KEY не задан.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Необязательно: переопределить модель для разговорного ответа/для извлечения
# данных на OpenRouter (по умолчанию — liquid/lfm-2.5-2.6b:free для обеих задач)
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_EXTRACT_MODEL=liquid/lfm-2.5-2.6b:free
