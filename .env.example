BOT_TOKEN=your_telegram_bot_token_here

# Telegram user_id администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789

# Бесплатный ключ OpenRouter (openrouter.ai/keys) — им бот ведёт живой диалог
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Необязательно: переопределить модель для разговорного ответа/для извлечения
# данных (по умолчанию — liquid/lfm-2.5-2.6b:free для обеих задач)
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_EXTRACT_MODEL=liquid/lfm-2.5-2.6b:free
